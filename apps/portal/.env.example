AUTHENTIK_ISSUER=http://localhost:9000/application/o/kimono-portal/
AUTHENTIK_CLIENT_ID=kimono-portal
AUTHENTIK_CLIENT_SECRET=use-the-same-value-as-kimono-portal-oidc-client-secret
AUTH_SECRET=generate-a-separate-session-secret
KIMONO_BASE_DOMAIN=example.com

# Optional path override. Production images include cloudflared; local
# development falls back to its official Docker image.
CLOUDFLARED_BIN=

# Identity host used for generated OIDC clients. Applications themselves are
# enabled and given hostnames in the Admin portal.
KIMONO_IDENTITY_DOMAIN=accounts.example.com
