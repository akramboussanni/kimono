# Copy this file to .env. Never commit the populated file.
# Generate both values with the commands documented in this directory's README.
PG_PASS=replace-with-a-random-database-password
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-secret

PG_DB=authentik
PG_USER=authentik
AUTHENTIK_TAG=2026.5.6
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# Used by the Kimono Portal blueprint. Use a separate random value.
KIMONO_PORTAL_OIDC_CLIENT_ID=kimono-portal
KIMONO_PORTAL_OIDC_CLIENT_SECRET=replace-with-a-random-oidc-secret
