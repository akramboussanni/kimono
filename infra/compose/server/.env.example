# Copy to .env and replace every value marked "replace-with".
# The two public names must resolve directly to this VM. Do not enable the
# Cloudflare proxy for MESH_DOMAIN; Headscale's control protocol requires a
# direct HTTPS connection.
AUTHENTIK_DOMAIN=accounts.example.com
MESH_DOMAIN=mesh.example.com
MAGIC_DNS_DOMAIN=kimono.internal
ACME_EMAIL=admin@example.com

AUTHENTIK_TAG=2026.5.6
HEADSCALE_TAG=0.28.0
CADDY_TAG=2.10.2-alpine

PG_DB=authentik
PG_USER=authentik
PG_PASS=replace-with-a-random-database-password
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-secret

KIMONO_HEADSCALE_OIDC_CLIENT_ID=kimono-headscale
KIMONO_HEADSCALE_OIDC_CLIENT_SECRET=replace-with-a-random-oidc-secret
KIMONO_HEADSCALE_OIDC_REDIRECT_URI=https://mesh.example.com/oidc/callback
KIMONO_HEADSCALE_OIDC_ISSUER=https://accounts.example.com/application/o/kimono-headscale/

# How long a browser-enrolled node remains authorized. "0" disables expiry.
HEADSCALE_NODE_EXPIRY=180d

# `kimono server install` sets these to extracted appliance assets. The
# defaults in compose.yml continue to work when running from this repository.
# KIMONO_SAKURA_ASSET_PATH=/var/lib/kimono/server/assets/sakura-branch-v2.png
# KIMONO_MARK_ASSET_PATH=/var/lib/kimono/server/assets/kimono-sakura-mark.svg
